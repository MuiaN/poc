# ── FRED BLACK — Environment Variables ──────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── Server ──────────────────────────────────────────────────────
PORT=10000
NODE_ENV=development          # set to "production" on Render

# ── Database ─────────────────────────────────────────────────────
# Render PostgreSQL connection string (found in your Render DB dashboard)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# ── Auth ─────────────────────────────────────────────────────────
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ── App URL ──────────────────────────────────────────────────────
# Your Render service URL — used to build invite links in emails
APP_URL=https://your-service-name.onrender.com

# ── Email — choose ONE provider ──────────────────────────────────

# Option A: Resend (recommended — free tier → https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=FRED BLACK <noreply@yourdomain.com>

# Option B: Generic SMTP (Gmail, Outlook, Brevo, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=FRED BLACK <you@gmail.com>

# ─────────────────────────────────────────────────────────────────
# If no email provider is set, invite links are printed to the
# server console and included in the API response (dev mode only).
